---
layout: none
permalink: /feeds/linkedin.xml
sitemap: false
author_profile: false
---
<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%}
  Feed read by the RSS-to-LinkedIn automation. Unlike /feed.xml, every item
  carries a plain-text description and a valid image URL.

  Per-post front matter:
    linkedin: false      keep the post out of this feed
    linkedin_caption: >-  the full LinkedIn post, written for LinkedIn; without
                          it the automation posts title + description + link
    linkedin_images:      photos attached to the LinkedIn post (a path or a
                          list of paths, at most 9). Defaults to the post's
                          `image:`. Set to false to post a link card instead.

  With photos, LinkedIn shows the photos and no link card, so the blog link
  is only the address in the text. A post with neither `linkedin_images` nor
  `image` goes out as a link card. Photos must be JPG, PNG or GIF.

  A caption is plain text (LinkedIn shows Markdown literally). Write it as a
  folded block (`>-`): wrap lines freely and leave a blank line between
  paragraphs. Each paragraph is posted with a blank line after it. `{url}` in
  a caption becomes the post's address. Paragraph breaks travel as escaped
  <br /> tags so that no feed parser can collapse them; the automation turns
  them back into blank lines.
{%- endcomment %}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/" xmlns:lab="https://krotosbenjamin.github.io/feeds/ns">
  <channel>
    <title>HEART-GeN Lab blog</title>
    <link>{{ "/" | absolute_url | xml_escape }}</link>
    <description>{{ site.description | normalize_whitespace | xml_escape }}</description>
    <language>{{ site.locale | default: "en-US" }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <atom:link href="{{ page.url | absolute_url | xml_escape }}" rel="self" type="application/rss+xml" />
    {%- assign shown = 0 -%}
    {%- for post in site.posts -%}
      {%- if post.linkedin == false -%}{%- continue -%}{%- endif -%}
      {%- if shown >= 10 -%}{%- break -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}

      {%- assign item_url = post.url | absolute_url | xml_escape -%}

      {%- if post.description -%}
        {%- assign item_text = post.description | normalize_whitespace | xml_escape -%}
      {%- else -%}
        {%- assign item_text = post.excerpt | strip_html | normalize_whitespace | xml_escape -%}
      {%- endif -%}

      {%- assign item_caption = "" -%}
      {%- if post.linkedin_caption -%}
        {%- assign plain_url = post.url | absolute_url -%}
        {%- assign item_caption = post.linkedin_caption | strip | replace: "{url}", plain_url | newline_to_br | xml_escape -%}
      {%- endif -%}

      {%- comment -%} Photos for the LinkedIn post, as one space-separated list. {%- endcomment -%}
      {%- assign photo_paths = "" | split: "," -%}
      {%- if post.linkedin_images == false -%}
      {%- elsif post.linkedin_images -%}
        {%- assign photo_paths = post.linkedin_images | join: "," | split: "," -%}
      {%- elsif post.image -%}
        {%- assign photo_paths = post.image | join: "," | split: "," -%}
      {%- endif -%}
      {%- assign item_photos = "" -%}
      {%- for photo_path in photo_paths limit: 9 -%}
        {%- assign photo_url = photo_path | strip | absolute_url | xml_escape -%}
        {%- assign item_photos = item_photos | append: " " | append: photo_url -%}
      {%- endfor -%}
      {%- assign item_photos = item_photos | strip -%}

      {%- comment -%} Same image choice as _includes/seo.html. {%- endcomment -%}
      {%- assign front_image = post.image | join: "," | split: "," | first -%}
      {%- assign item_image = post.header.og_image | default: post.header.overlay_image | default: post.header.image | default: front_image | default: post.header.teaser | default: site.og_image | absolute_url | xml_escape -%}
      {%- assign image_ext = item_image | split: "." | last | downcase -%}
      {%- assign image_type = "image/jpeg" -%}
      {%- if image_ext == "png" -%}{%- assign image_type = "image/png" -%}{%- endif -%}
      {%- if image_ext == "gif" -%}{%- assign image_type = "image/gif" -%}{%- endif %}
    <item>
      <title>{{ post.title | strip_html | normalize_whitespace | xml_escape }}</title>
      <link>{{ item_url }}</link>
      <guid isPermaLink="true">{{ item_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <description>{{ item_text }}</description>
      {%- if item_caption != "" %}
      <lab:linkedinPost>{{ item_caption }}</lab:linkedinPost>
      {%- endif %}
      {%- if item_photos != "" %}
      <lab:linkedinImages>{{ item_photos }}</lab:linkedinImages>
      {%- endif %}
      <enclosure url="{{ item_image }}" type="{{ image_type }}" length="0" />
      <media:content url="{{ item_image }}" medium="image" type="{{ image_type }}" />
      <media:thumbnail url="{{ item_image }}" />
    </item>
    {%- endfor %}
  </channel>
</rss>
